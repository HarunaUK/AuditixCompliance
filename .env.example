# Copy to .env for local runs. Never commit real values.

# Postgres. Locally this points at the Prisma dev daemon (npm run db:start).
# On a host use the *pooled* connection string, e.g. Neon's "-pooler" URL.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/auditix?sslmode=disable&connection_limit=1"
# Optional: direct (non-pooled) URL used only for `prisma migrate` / seeding.
# DIRECT_URL="postgres://user:pass@host/db?sslmode=require"

# Signs the HttpOnly session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Public origin, used for absolute links and metadata.
NEXT_PUBLIC_APP_URL="http://127.0.0.1:8077"

# "local" writes uploads to .data/uploads (fine locally, ephemeral on serverless).
# Use "s3" with the variables below for Cloudflare R2 or any S3-compatible bucket.
STORAGE_DRIVER="local"
# S3_BUCKET=""
# S3_REGION="auto"
# S3_ENDPOINT=""            # e.g. https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# Demo credentials shown on the sign-in page.
DEMO_EMAIL="auditix@faseel.app"
DEMO_PASSWORD=""

# Virtual CISO + AI policy generation (any OpenAI-compatible provider).
# Defaults below use Pollinations, a free endpoint with no account or key needed.
# Free tiers are rate limited (about one reply every 45s per IP). For unlimited,
# set AI_KEYLESS="0", put a key in AI_API_KEY, and point AI_BASE_URL/AI_MODEL at
# OpenAI, Z.ai, Groq or OpenRouter.
AI_KEYLESS="1"
AI_API_KEY=""
AI_BASE_URL="https://text.pollinations.ai/openai"
AI_MODEL="openai-fast"
# "low" keeps reasoning models from burning the reply budget on deliberation.
AI_REASONING_EFFORT="low"
